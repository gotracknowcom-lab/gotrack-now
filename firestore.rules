rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn();
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read, update, delete: if isOwner(userId) || isAdmin();
      allow create: if signedIn() && request.auth.uid == userId;
    }

    // Shipments (Public tracking search & admin management)
    match /shipments/{shipmentId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Tracking history
    match /trackingHistory/{historyId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Live Chat Messages (Public visitors can read & post support chat)
    match /chat_messages/{messageId} {
      allow read, create: if true;
      allow update, delete: if true;
    }

    // Messages / Contact Form (Public visitors can submit inquiries)
    match /messages/{messageId} {
      allow read, create: if true;
      allow update, delete: if true;
    }

    match /contactMessages/{messageId} {
      allow read, create: if true;
      allow update, delete: if true;
    }

    // Admin & Operational Notifications
    match /admin_notifications/{notificationId} {
      allow read, create: if true;
      allow update, delete: if true;
    }

    match /notifications/{notificationId} {
      allow read, create: if true;
      allow update, delete: if true;
    }

    // System & General Settings
    match /system_settings/{document} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{document} {
      allow read: if true;
      allow write: if true;
    }

    // Activity & Audit Logs
    match /activity_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if true;
    }

    // Email Dispatch Logs
    match /email_logs/{emailLogId} {
      allow read, create: if true;
      allow update, delete: if true;
    }

    // Analytics
    match /analytics/{document} {
      allow read, write: if true;
    }

    // Fallback for all other collections to guarantee smooth operation across the website
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
