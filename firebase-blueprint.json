{
  "entities": {
    "Shipment": {
      "title": "Shipment",
      "description": "Consignment tracking record with GPS coordinates, timeline events, and package info.",
      "type": "object",
      "properties": {
        "trackingCode": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string font-email" },
        "customerPhone": { "type": "string" },
        "shipmentType": { "type": "string" },
        "courier": { "type": "string" },
        "packageName": { "type": "string" },
        "currentStatus": { "type": "string" }
      },
      "required": ["trackingCode", "customerName", "currentStatus"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Live support chat message associated with a tracking code.",
      "type": "object",
      "properties": {
        "shipmentId": { "type": "string" },
        "trackingCode": { "type": "string" },
        "sender": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["trackingCode", "sender", "text"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "General customer query or contact form message.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "message"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit and operational activity logs.",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "EmailLog": {
      "title": "EmailLog",
      "description": "Transactional email dispatch record.",
      "type": "object",
      "properties": {
        "trackingCode": { "type": "string" },
        "recipientEmail": { "type": "string" },
        "subject": { "type": "string" },
        "sentAt": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "AdminNotification": {
      "title": "AdminNotification",
      "description": "Internal operational notifications for logistics controllers.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/shipments/{shipmentId}": {
      "schema": "Shipment",
      "description": "All tracking consignments"
    },
    "/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Customer live support chat messages"
    },
    "/messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Customer contact form queries"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Admin audit log records"
    },
    "/email_logs/{emailLogId}": {
      "schema": "EmailLog",
      "description": "Transactional email log records"
    },
    "/admin_notifications/{notificationId}": {
      "schema": "AdminNotification",
      "description": "Admin system notifications"
    }
  }
}
